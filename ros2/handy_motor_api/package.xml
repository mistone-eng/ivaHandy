<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>handy_motor_api</name>
  <version>0.1.0</version>
  <description>ROS-free C++ motor API for Handy's Dynamixel Protocol 1.0 servos (on top of the Dynamixel SDK), plus a CLI</description>
  <maintainer email="opconnell@gmail.com">owenc</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>dynamixel_sdk</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
