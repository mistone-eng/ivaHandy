<?xml version="1.0"?>
<!-- Kept so MoveItConfigsBuilder / Setup Assistant find the URDF by their naming convention.
     The real description lives in handy_description/urdf/handy.urdf.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="handy_description">
    <xacro:arg name="use_mock" default="true" />
    <xacro:include filename="$(find handy_description)/urdf/handy.urdf.xacro" />
</robot>
