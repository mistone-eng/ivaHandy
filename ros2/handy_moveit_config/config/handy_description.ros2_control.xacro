<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- One Dynamixel (Protocol 1.0) joint. model: AX, RX, EX or MX. init only used by mock. -->
    <xacro:macro name="dxl_joint" params="name id model sign:=1 offset_ticks:=0 init:=0.0">
        <joint name="${name}">
            <param name="id">${id}</param>
            <param name="model">${model}</param>
            <param name="sign">${sign}</param>
            <param name="offset_ticks">${offset_ticks}</param>
            <command_interface name="position"/>
            <state_interface name="position">
              <param name="initial_value">${init}</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <!-- A servo that mirrors another joint (state only; goal = leader_cmd * multiplier). -->
    <xacro:macro name="dxl_follower_joint" params="name id model follows multiplier:=1 sign:=1 offset_ticks:=0">
        <joint name="${name}">
            <param name="id">${id}</param>
            <param name="model">${model}</param>
            <param name="sign">${sign}</param>
            <param name="offset_ticks">${offset_ticks}</param>
            <param name="follows">${follows}</param>
            <param name="follow_multiplier">${multiplier}</param>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="handy_description_ros2_control" params="name initial_positions_file use_mock:=true">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_mock}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_mock}">
                    <plugin>dynamixel_handy_interface/DynamixelHandyInterface</plugin>
                    <param name="port">/dev/ttyUSB0</param>
                    <param name="baud">1000000</param>
                    <param name="moving_speed">50</param> <!-- Originally 100 -->
                    <param name="torque_limit">200</param> <!-- Originally 512 -->
                </xacro:unless>
            </hardware>

            <xacro:dxl_joint name="joint_1" id="1" model="EX" init="${initial_positions['joint_1']}"/>
            <xacro:dxl_joint name="joint_2" id="2" model="MX" init="${initial_positions['joint_2']}"/>
            <xacro:dxl_joint name="joint_3" id="3" model="EX" init="${initial_positions['joint_3']}"/>
            <xacro:dxl_joint name="joint_4" id="4" model="EX" init="${initial_positions['joint_4']}"/>
            <xacro:dxl_joint name="joint_5" id="5" model="MX" init="${initial_positions['joint_5']}"/>
            <xacro:dxl_joint name="joint_6" id="6" model="MX" init="${initial_positions['joint_6']}"/>
            <xacro:dxl_joint name="joint_7" id="7" model="MX" init="${initial_positions['joint_7']}"/>
            <xacro:dxl_joint name="joint_8" id="8" model="AX" init="${initial_positions['joint_8']}"/>

            <!-- Second finger: real hardware only. In mock mode the URDF <mimic> drives it. -->
            <xacro:unless value="${use_mock}">
                <xacro:dxl_follower_joint name="joint_9" id="9" model="AX" follows="joint_8" multiplier="-1"/>
            </xacro:unless>
        </ros2_control>
    </xacro:macro>
</robot>