<?xml version="1.0"?>
<!--
  ros2_control block for Handy.
  Servo ids/models/signs come from config/hardware.yaml, zero offsets from config/calibration.yaml
  (written by handy_calibrate). Do not hard-code them here.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- One commanded Dynamixel joint. init is only used by the mock hardware. -->
    <xacro:macro name="dxl_joint" params="name hw cal init:=0.0">
        <xacro:property name="j" value="${hw['joints'][name]}"/>
        <joint name="${name}">
            <param name="id">${j['id']}</param>
            <param name="model">${j['model']}</param>
            <param name="sign">${j['sign']}</param>
            <param name="offset_ticks">${cal['offset_ticks'][name]}</param>
            <command_interface name="position"/>
            <state_interface name="position">
              <param name="initial_value">${init}</param>
            </state_interface>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <!-- A servo that mirrors another joint (state only; goal = leader_cmd * multiplier). -->
    <xacro:macro name="dxl_follower_joint" params="name hw cal">
        <xacro:property name="j" value="${hw['joints'][name]}"/>
        <joint name="${name}">
            <param name="id">${j['id']}</param>
            <param name="model">${j['model']}</param>
            <param name="sign">${j['sign']}</param>
            <param name="offset_ticks">${cal['offset_ticks'][name]}</param>
            <param name="follows">${j['follows']}</param>
            <param name="follow_multiplier">${j['multiplier']}</param>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="handy_description_ros2_control"
                 params="name initial_positions_file hardware_file calibration_file use_mock:=true">
        <xacro:property name="init" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <xacro:property name="hw" value="${xacro.load_yaml(hardware_file)}"/>
        <xacro:property name="cal" value="${xacro.load_yaml(calibration_file)}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_mock}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_mock}">
                    <plugin>handy_hardware/DynamixelSystem</plugin>
                    <param name="port">${hw['bus']['port']}</param>
                    <param name="baud">${hw['bus']['baud']}</param>
                    <param name="moving_speed">${hw['bus']['moving_speed']}</param>
                    <param name="torque_limit">${hw['bus']['torque_limit']}</param>
                </xacro:unless>
            </hardware>

            <xacro:dxl_joint name="joint_1" hw="${hw}" cal="${cal}" init="${init['joint_1']}"/>
            <xacro:dxl_joint name="joint_2" hw="${hw}" cal="${cal}" init="${init['joint_2']}"/>
            <xacro:dxl_joint name="joint_3" hw="${hw}" cal="${cal}" init="${init['joint_3']}"/>
            <xacro:dxl_joint name="joint_4" hw="${hw}" cal="${cal}" init="${init['joint_4']}"/>
            <xacro:dxl_joint name="joint_5" hw="${hw}" cal="${cal}" init="${init['joint_5']}"/>
            <xacro:dxl_joint name="joint_6" hw="${hw}" cal="${cal}" init="${init['joint_6']}"/>
            <xacro:dxl_joint name="joint_7" hw="${hw}" cal="${cal}" init="${init['joint_7']}"/>
            <xacro:dxl_joint name="joint_8" hw="${hw}" cal="${cal}" init="${init['joint_8']}"/>

            <!-- Second finger: real hardware only. In mock mode the URDF <mimic> drives it. -->
            <xacro:unless value="${use_mock}">
                <xacro:dxl_follower_joint name="joint_9" hw="${hw}" cal="${cal}"/>
            </xacro:unless>
        </ros2_control>
    </xacro:macro>
</robot>
