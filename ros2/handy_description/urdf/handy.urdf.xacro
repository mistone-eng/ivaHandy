<?xml version="1.0"?>
<!--
  Top-level Handy description: kinematic model + ros2_control block.
  This is the ONE file every launch file should load.

    xacro handy.urdf.xacro use_mock:=true    -> mock_components/GenericSystem
    xacro handy.urdf.xacro use_mock:=false   -> real Dynamixels (handy_hardware plugin)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="handy_description">
    <xacro:arg name="use_mock" default="true" />
    <xacro:arg name="initial_positions_file"
               default="$(find handy_description)/config/initial_positions.yaml" />
    <xacro:arg name="hardware_file"
               default="$(find handy_description)/config/hardware.yaml" />
    <xacro:arg name="calibration_file"
               default="$(find handy_description)/config/calibration.yaml" />

    <!-- Must come BEFORE the include: xacro keeps the first definition of an arg.
         Turns off the legacy ros2_control block inside handy_description.urdf.xacro. -->
    <xacro:arg name="description_ros2_control" default="false" />
    <xacro:include filename="$(find handy_description)/urdf/handy_description.urdf.xacro" />

    <xacro:include filename="$(find handy_description)/urdf/handy.ros2_control.xacro" />
    <xacro:handy_description_ros2_control name="HandySystem"
        initial_positions_file="$(arg initial_positions_file)"
        hardware_file="$(arg hardware_file)"
        calibration_file="$(arg calibration_file)"
        use_mock="$(arg use_mock)"/>
</robot>
