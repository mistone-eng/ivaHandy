<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>handy_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files composing the Handy hardware, MoveIt and Servo layers</description>
  <maintainer email="opconnell@gmail.com">owenc</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>handy_control</exec_depend>
  <exec_depend>handy_moveit_config</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
